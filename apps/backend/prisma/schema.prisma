// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Catalog {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
  code String @db.VarChar(255)

  parentId Int?
  parent   Catalog?  @relation("CatalogToCatalog", fields: [parentId], references: [id])
  children Catalog[] @relation("CatalogToCatalog")

  documents Document[]
}

model Document {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(255)
  objectName String  @db.VarChar(255)
  filePath  String?  @db.VarChar(500)
  
  catalogId Int
  catalog   Catalog  @relation(fields: [catalogId], references: [id])
  
  idn       String?  @db.VarChar(100)
  
  // OCR results
  ocrText   String?  @db.Text
  
  // ML classification results
  documentType String? @db.VarChar(100) // passport, driver_license, etc.
  confidence   Float?
  
  // Extracted structured data (JSON)
  extractedData Json?
  
  // Processing status
  status    String   @default("pending") @db.VarChar(50) // pending, processing, completed, failed
  jobId     String?  @db.VarChar(100)
  error     String?  @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
